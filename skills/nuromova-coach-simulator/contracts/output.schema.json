{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "waiting_data",
        "unavailable"
      ]
    },
    "message": {
      "type": "string"
    },
    "question": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "answer_tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "text",
            "answer_tags"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "hypothesis": {
      "type": [
        "string",
        "null"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "unit",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "next_step": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "sport_config": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "knowledge": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "prompt",
        "sport_config",
        "rules",
        "knowledge"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "input_hash",
    "status",
    "message",
    "question",
    "fact_refs",
    "knowledge_refs",
    "hypothesis",
    "unknowns",
    "action",
    "quantities",
    "summary",
    "next_step",
    "versions"
  ],
  "additionalProperties": false
}
