{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "knowledge",
        "product_rule",
        "case",
        "dispute"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "section",
        "base_revision"
      ],
      "additionalProperties": false
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "url",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "evidence_type": {
            "enum": [
              "research_supported",
              "expert_experience",
              "mixed",
              "unverified"
            ]
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "pending",
              "confirmed",
              "disputed",
              "withdrawn"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_doc_id": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "content",
          "conditions",
          "boundaries",
          "sources",
          "evidence_type",
          "review_status",
          "reviewer",
          "reviewed_at",
          "source_doc_id",
          "source_revision",
          "valid"
        ],
        "additionalProperties": false
      }
    },
    "expert_source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "conversation_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "conversation_ref"
      ],
      "additionalProperties": false
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "content_hash": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "message_ref": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "content_hash",
            "quote",
            "message_ref",
            "approved_at"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "target",
    "before",
    "after",
    "reason",
    "units",
    "expert_source",
    "approval"
  ],
  "additionalProperties": false
}
